# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Database Configuration
# PostgreSQL Production: postgresql+asyncpg://postgres:password@localhost:5432/e_murojaat
# Local Development (SQLite): sqlite+aiosqlite:///data/e_murojaat.db
DATABASE_URL=sqlite+aiosqlite:///data/e_murojaat.db

# Redis Configuration (Optional, fallback to MemoryStorage if empty)
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Super Administrator Telegram ID
SUPER_ADMIN_ID=123456789

# Dekan Telegram ID
DEKAN_ID=0

# Timezone & Environment
TIMEZONE=Asia/Tashkent
APP_ENV=production
LOG_LEVEL=INFO

# File Upload Settings
MAX_FILE_SIZE_MB=20

# UptimeRobot & Web Keep-Alive Settings (For Render / Koyeb / Railway 24/7 online)
ENABLE_WEB_SERVER=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Optional: Self-ping URL if you host on Render/Koyeb (e.g. https://e-murojaat.onrender.com)
# SELF_PING_URL=https://your-bot-app.onrender.com
SELF_PING_INTERVAL_MINUTES=10

